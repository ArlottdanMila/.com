
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Jalon Starboy MLBB</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#0b1020;color:white;font-family:Arial,sans-serif}
header{text-align:center;padding:30px 15px;background:linear-gradient(135deg,#243d78,#10152b)}
h1{color:#ffd166}
nav{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;padding:15px;background:#151d35}
a{color:#63e6ff;text-decoration:none}
section{padding:20px;max-width:900px;margin:auto}
.card{background:#192544;border:1px solid #34466e;padding:15px;margin:10px 0;border-radius:12px}
button,input,select{padding:12px;border-radius:8px;border:0;margin:5px}
input,select{max-width:100%;background:#202d4d;color:white}
button{background:#ffd166;font-weight:bold}
footer{text-align:center;padding:25px;background:#151d35}
</style>
</head>
<body>
<header>
<h1>⚡ JALON STARBOY</h1>
<h2>Mobile Legends Season 42</h2>
<p>Hero Meta • Counter Hero • Item • Build</p>
</header>

<nav>
<a href="#meta">Hero Meta</a>
<a href="#counter">Counter Hero</a>
<a href="#items">Item MLBB</a>
<a href="#build">Build</a>
<a href="#kontak">Kontak</a>
</nav>

<section id="meta">
<h2>🏆 Hero Meta Season 42</h2>
<input id="cariHero" placeholder="Cari nama hero..." oninput="tampil()">
<div id="daftarHero"></div>
</section>

<section id="counter">
<h2>⚔️ Counter Hero</h2>
<div class="card">
<h3>Ling / hero lincah</h3>
<p>Counter pilihan: Khufra atau Phoveus.
Gunakan crowd control pada waktu yang tepat.</p>
</div>
<div class="card">
<h3>Hero dengan healing tinggi</h3>
<p>Pertimbangkan item anti-heal seperti Sea Halberd
atau Dominance Ice sesuai role dan versi game.</p>
</div>
<div class="card">
<h3>Marksman basic attack</h3>
<p>Pertimbangkan Lolita untuk perlindungan tim.
Sesuaikan pilihan dengan skill lawan.</p>
</div>
<div class="card">
<h3>Tank dengan HP tebal</h3>
<p>Pertimbangkan Karrie atau item penetration
yang sesuai dengan tipe damage hero kamu.</p>
</div>
<div class="card">
<h3>Hero mage burst</h3>
<p>Jaga jarak, hindari semak tanpa vision,
dan pertimbangkan Athena's Shield jika cocok.</p>
</div>
</section>

<section id="items">
<h2>🛡️ Item Mobile Legends</h2>
<select id="kategori" onchange="tampilItem()">
<option value="Semua">Semua kategori</option>
<option>Physical</option>
<option>Magic</option>
<option>Defense</option>
<option>Movement</option>
</select>
<div id="daftarItem"></div>
</section>

<section id="build">
<h2>🧩 Contoh Build</h2>
<div class="card">
<h3>Marksman</h3>
<p>Swift Boots • Berserker's Fury • Haas's Claws
• Windtalker • Malefic Roar • Wind of Nature</p>
</div>
<div class="card">
<h3>Mage</h3>
<p>Arcane Boots • Genius Wand • Holy Crystal
• Divine Glaive • Lightning Truncheon • Winter Crown</p>
</div>
<div class="card">
<h3>Tank</h3>
<p>Tough Boots • Dominance Ice • Athena's Shield
• Antique Cuirass • Radiant Armor • Immortality</p>
</div>
</section>

<section id="kontak">
<h2>📱 Media Sosial</h2>
<div class="card">
<a href="https://www.tiktok.com/@villains_starboy?" target="_blank">TikTok Jalon Starboy</a>
</div>
<div class="card">
<a href="https://wa.me/6281578202783" target="_blank">WhatsApp Jalon Starboy</a>
</div>
</section>

<footer>
<p>© 2026 Jalon Starboy</p>
<p>Fan-made Mobile Legends website</p>
</footer>

<script>
const heroes=[
["Rafaela","Support","Healing dan kecepatan gerak."],
["Aulus","Fighter","Kuat saat mendapatkan item."],
["Masha","Fighter","Duel dan tekanan lane."],
["Argus","Fighter","Manfaatkan ultimate saat bertarung."],
["Minotaur","Tank","Inisiasi dan crowd control."],
["Khufra","Tank","Menghambat hero dengan dash."],
["Floryn","Support","Healing untuk rekan satu tim."],
["Gloo","Tank","Mengganggu formasi lawan."],
["Carmilla","Support","Kuat dalam team fight."],
["Obsidia","Marksman","Lindungi saat farming."],
["Popol & Kupa","Marksman","Trap dan kontrol area."],
["Valir","Mage","Poke dan efek slow."],
["Diggie","Support","Membantu menghadapi crowd control."],
["Bruno","Marksman","Damage critical."],
["Ling","Assassin","Mobilitas tinggi."]
];

const items=[
["Blade of Despair","Physical","Damage fisik tinggi."],
["Berserker's Fury","Physical","Critical damage."],
["Malefic Roar","Physical","Physical penetration."],
["Sea Halberd","Physical","Pilihan anti-heal."],
["Wind of Nature","Physical","Perlindungan dari physical damage."],
["War Axe","Physical","Pertarungan berkelanjutan."],
["Holy Crystal","Magic","Magic power."],
["Divine Glaive","Magic","Magic penetration."],
["Genius Wand","Magic","Mengurangi magic defense lawan."],
["Lightning Truncheon","Magic","Damage burst magic."],
["Winter Crown","Magic","Efek pertahanan aktif."],
["Athena's Shield","Defense","Menghadapi magic burst."],
["Dominance Ice","Defense","Defense dan efek anti-heal sesuai versi."],
["Antique Cuirass","Defense","Menghadapi physical skill."],
["Immortality","Defense","Kesempatan bangkit kembali."],
["Swift Boots","Movement","Attack speed."],
["Tough Boots","Movement","Magic defense dan ketahanan kontrol."],
["Arcane Boots","Movement","Penetrasi magic."]
];

function tampil(){
let q=document.getElementById("cariHero").value.toLowerCase();
document.getElementById("daftarHero").innerHTML=
heroes.filter(h=>h.join(" ").toLowerCase().includes(q))
.map(h=>`<div class="card"><h3>${h[0]}</h3>
<p>Role: ${h[1]}</p><p>${h[2]}</p></div>`).join("");
}

function tampilItem(){
let c=document.getElementById("kategori").value;
document.getElementById("daftarItem").innerHTML=
items.filter(i=>c==="Semua"||i[1]===c)
.map(i=>`<div class="card"><h3>${i[0]}</h3>
<p>${i[1]} • ${i[2]}</p></div>`).join("");
}

tampil();
tampilItem();
</script>
</body>
</html>
